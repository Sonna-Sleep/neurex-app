{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".ts-out"
  },
  "include": [
    "*.ts",
    "../src/**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
