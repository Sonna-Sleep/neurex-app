{
  "expo": {
    "name": "Neurex",
    "slug": "neurex-app",
    "scheme": "neurex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.neurex.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Neurex uses Bluetooth to sync your sleep data from the headband.",
        "NSBluetoothPeripheralUsageDescription": "Neurex uses Bluetooth to communicate with your headband.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "tech.neurex.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Neurex uses Bluetooth to sync your sleep data from the headband."
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fe1a23fd-e318-40fe-82d4-a1c332761c7d"
      }
    },
    "owner": "aleksas2006",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fe1a23fd-e318-40fe-82d4-a1c332761c7d"
    }
  }
}
