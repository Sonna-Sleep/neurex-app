# Supabase — get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Modal — the deployed processing endpoint that receives recordings from the
# phone, decodes/analyzes them, and writes session rows to Supabase. URL is
# stable per deploy; rotate only if you redeploy under a different label.
EXPO_PUBLIC_MODAL_ENDPOINT_URL=

# Testing only. Keep 0 in production so the skip-login button stays hidden.
EXPO_PUBLIC_DEV_BYPASS=0

# Optional emergency fallback. Default is segments-first upload. Set to 0 only
# if you need to temporarily return to the old local EEG.BIN writer.
EXPO_PUBLIC_CHUNKED_UPLOAD=1
